# ============================================================================
# HANDVANCE TECHNOLOGIES — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file or real credentials to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL DATABASE CONNECTIONS (PRISMA ORM)
# ----------------------------------------------------------------------------
# DATABASE_URL: Supabase Transaction Connection Pooler (Port 6543)
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Direct Database Connection (Port 5432)
# Required by Prisma to execute migrations and schema updates without connection pooling issues.
# Format: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# 2. SUPABASE API CREDENTIALS & CLIENT KEYS
# ----------------------------------------------------------------------------
# Project URL: Found under Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Public Anon Key: Safe to expose in browser; subject to Row Level Security (RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Service Role Key: ⚠️ STRICTLY CONFIDENTIAL SERVER-SIDE ONLY KEY
# Bypasses RLS. NEVER expose this in client components or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ----------------------------------------------------------------------------
# 3. SUPABASE STORAGE BUCKETS (Defaults configured in storageService.ts)
# ----------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET_PROJECTS="project-images"
SUPABASE_STORAGE_BUCKET_TEAM="team-photos"
SUPABASE_STORAGE_BUCKET_RESUMES="resumes"

# ----------------------------------------------------------------------------
# 4. APPLICATION & SECURITY SETTINGS
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://handvance-technologies.vercel.app"
NODE_ENV="development"
